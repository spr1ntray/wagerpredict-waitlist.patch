{
  "$schema": "https://soft-hub.local/schemas/plugin-v1.json",
  "schema_version": 1,
  "contract_version": "SH-SOFTWARE-0.6/4",
  "id": "io.sprintray.wagerpredict-testnet",
  "name": "Wager",
  "version": "1.24.0",
  "description": "Заявка в очередь mainnet beta Wager Predict по кошельку и почте аккаунта.",
  "author": "sprintray",
  "presentation": {
    "display_name": "Wager",
    "description": "Подаёт заявку в очередь mainnet beta по кошельку и почте из Hub. Если адрес уже в очереди или в списке — пропускает.",
    "assets": {
      "icon": "assets/icon.png",
      "image": "assets/image.png"
    }
  },
  "catalog": {
    "sections": ["general"]
  },
  "compatibility": {
    "hub": ">=0.6.15",
    "python": ">=3.12,<3.13",
    "os": ["darwin"]
  },
  "runtime": {
    "type": "python",
    "entrypoint": "plugin.main:run",
    "protocol": "soft-hub-jsonl/1",
    "state_model": "externally_reconciled",
    "requirements": "requirements.txt",
    "safe_stop": true,
    "heartbeat_seconds": 15
  },
  "permissions": {
    "secrets": [
      "evm_private_key",
      "proxy",
      "email"
    ],
    "network": [
      "api.predictprotocol.app",
      "wagerpredict.com"
    ],
    "chains": [],
    "financial_risk": "none",
    "browser": false,
    "local_services": []
  },
  "actions": [
    {
      "id": "register",
      "name": "Заявка",
      "description": "Отправляет кошелёк и почту в очередь mainnet. Повторно уже поданные адреса не трогает.",
      "risk": "external_write",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": [
          "evm_private_key",
          "proxy",
          "email"
        ]
      },
      "resources": {
        "account": ["private_key", "proxy", "email"],
        "settings": []
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько заявок софт отправляет одновременно. Для записи безопаснее держать около трёх.",
            "default": 3,
            "minimum": 1,
            "maximum": 8,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          },
          "pause_from_ms": {
            "type": "integer",
            "title": "Пауза перед заявкой",
            "description": "Случайная пауза перед отправкой. Снижает шанс упереться в лимит проекта.",
            "default": 400,
            "minimum": 0,
            "maximum": 8000,
            "multipleOf": 100,
            "x-ui": {
              "group": "Темп",
              "order": 10,
              "unit": "мс",
              "advanced": true,
              "control": "dual_range",
              "range": {"id": "pause", "role": "from"}
            }
          },
          "pause_to_ms": {
            "type": "integer",
            "title": "Пауза перед заявкой",
            "description": "Случайная пауза перед отправкой. Снижает шанс упереться в лимит проекта.",
            "default": 1200,
            "minimum": 0,
            "maximum": 8000,
            "multipleOf": 100,
            "x-ui": {
              "group": "Темп",
              "order": 20,
              "unit": "мс",
              "advanced": true,
              "control": "dual_range",
              "range": {"id": "pause", "role": "to"}
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "inspect",
      "name": "Парсинг",
      "description": "Показывает, в списке ли кошелёк и есть ли заявка. Ничего не меняет.",
      "risk": "read",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": ["proxy"]
      },
      "resources": {
        "account": ["proxy"],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Очередь Wager Predict",
        "primary_kind": "account_snapshot",
        "columns": [
          {"key": "allowed", "title": "Допущен", "type": "boolean"},
          {"key": "requested", "title": "Заявка", "type": "boolean"},
          {"key": "queue_status", "title": "Статус", "type": "string"}
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько профилей проверять одновременно.",
            "default": 5,
            "minimum": 1,
            "maximum": 10,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "ui": {
    "accent": "#3DDC97",
    "monogram": "WP"
  }
}
